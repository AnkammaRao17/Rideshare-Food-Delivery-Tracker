# MongoDB Connection URI (e.g. local or MongoDB Atlas)
# Local example: mongodb://localhost:27017/
# Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/

# Database names
DATABASE_NAME=rideshare_delivery_db
TEST_DATABASE_NAME=rideshare_delivery_test_db

# Application Settings
APP_PORT=8501
APP_HOST=localhost
DEBUG=False
